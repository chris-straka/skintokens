#!/bin/bash
# skintokens CLI shim: runs the Rust binary built in this checkout.
#   cargo build --release      (once; weights: ./fetch-weights.sh)
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
exe="$here/target/release/skintokens"
if [ ! -x "$exe" ]; then
  echo "skintokens: not built; run: cd $here && cargo build --release" >&2
  exit 2
fi
exec "$exe" "$@"
