--- /dev/null
+++ b/compat/flash_attn_interface.py
@@ -0,0 +1,19 @@
+"""SDPA stand-in for flash_attn_interface.flash_attn_func (FA3 API) on hosts
+without flash-attn. Layout (B, L, H, D) in and out; GQA by repeat; returns
+(out, None) like FA3."""
+import torch.nn.functional as F
+
+def flash_attn_func(q, k, v, *args, **kwargs):
+    q = q.transpose(1, 2)
+    k = k.transpose(1, 2)
+    v = v.transpose(1, 2)
+    if q.shape[1] != k.shape[1]:
+        r = q.shape[1] // k.shape[1]
+        k = k.repeat_interleave(r, dim=1)
+        v = v.repeat_interleave(r, dim=1)
+    if k.dtype != q.dtype:
+        k = k.to(q.dtype)
+    if v.dtype != q.dtype:
+        v = v.to(q.dtype)
+    out = F.scaled_dot_product_attention(q, k, v)
+    return out.transpose(1, 2), None
