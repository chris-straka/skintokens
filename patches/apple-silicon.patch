new file mode 100644
index 0000000..ae53e7b
--- /dev/null
+++ b/src/device.py
@@ -0,0 +1,18 @@
+"""Device selection for non-CUDA hosts (Apple Silicon port).
+
+SKINTOKENS_DEVICE=cuda|mps|cpu overrides; default: cuda, else mps, else cpu.
+"""
+import os
+import torch
+
+def _pick() -> str:
+    env = os.environ.get("SKINTOKENS_DEVICE")
+    if env:
+        return env
+    if torch.cuda.is_available():
+        return "cuda"
+    if torch.backends.mps.is_available():
+        return "mps"
+    return "cpu"
+
+DEVICE = _pick()
